<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                background-color: #f8f9fa;
                margin: 0;
                padding: 0;
            }

            #wrapper {
                display: flex;
                min-height: 100vh;
            }

            /* Sidebar Styling */
            #sidebar {
                width: 220px;
                background-color: #212529;
                color: #8a909d;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            #sidebar .sidebar-brand {
                padding: 15px 20px;
                font-size: 1.1rem;
                font-weight: 500;
                color: #ffffff;
                text-decoration: none;
                display: block;
            }

            #sidebar .sidebar-heading {
                padding: 12px 20px 5px;
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                color: #495057;
                letter-spacing: 0.05em;
            }

            #sidebar .nav-link {
                color: #adb5bd;
                padding: 10px 20px;
                font-size: 0.9rem;
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            #sidebar .nav-link:hover, #sidebar .nav-link.active {
                color: #ffffff;
            }

            #sidebar .sidebar-footer {
                padding: 15px 20px;
                background-color: #1a1d20;
                font-size: 0.8rem;
                color: #6c757d;
            }

            /* Main Content Area */
            #content-wrapper {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
            }

            /* Topbar Styling */
            .topbar {
                height: 56px;
                background-color: #212529;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 20px;
            }

            .topbar .btn-link {
                color: #6c757d;
                text-decoration: none;
            }

            .topbar .btn-link:hover {
                color: #ffffff;
            }

            .search-form {
                width: 300px;
            }

            /* Main Body Content */
            .main-content {
                padding: 25px;
                flex-grow: 1;
                background-color: #ffffff;
            }

            /* Footer Styling */
            footer.sticky-footer {
                padding: 15px 25px;
                background-color: #f8f9fa;
                border-top: 1px solid #e3e6f0;
                font-size: 0.85rem;
                color: #858796;
            }
    </style>
</head>
<body>

    <div id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar">
            <div>
                <a class="sidebar-brand" href="#">Management System</a>

                <div class="sidebar-heading">CORE</div>
                <a class="nav-link" href="#">
                    <i class="fa-solid fa-gauge"></i> Dashboard
                </a>

                <div class="sidebar-heading">ADDONS</div>
                <a class="nav-link" href="#">
                    <i class="fa-solid fa-diagram-project"></i> Branches
                </a>
                <a class="nav-link" href="#">
                    <i class="fa-solid fa-graduation-cap"></i> Students
                </a>
            </div>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                Logged in as: <br />
                <strong class="text-secondary">MyAccount</strong>
            </div>
        </div>

        <!-- Content Wrapper -->
        <div id="content-wrapper">
            <!-- Topbar Header -->
            <nav class="topbar">
                <button class="btn btn-link btn-sm text-secondary" id="sidebarToggle">
                    <i class="fas fa-bars fs-5"></i>
                </button>

                <div class="d-flex align-items-center gap-3">
                    <!-- Search Bar -->
                    <form class="d-flex search-form">
                        <input class="form-control form-control-sm rounded-0 rounded-start" type="search" placeholder="Search for..." aria-label="Search">
                        <button class="btn btn-primary btn-sm rounded-0 rounded-end" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>

                    <!-- User Account Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="text-secondary text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle fs-5"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="#">Profile</a></li>
                            <li><a class="dropdown-item" href="#">Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Page Content -->
            <div class="main-content">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="sticky-footer">
                <div class="container my-auto">
                    <div class="copyright text-muted">
                        <span>Copyright &copy; 2023</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>